{
  "name": "server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --build",
    "test:unit": "vitest run",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "auth:generate": "DATABASE_URL=postgresql://localhost:5432/placeholder better-auth generate --config ./src/auth.ts --output ./src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.26",
    "@fohte/ddr-score-manager-parser": "workspace:*",
    "@fohte/service-kit": "0.1.8",
    "@hono/node-server": "2.0.10",
    "@opentelemetry/api": "1.9.1",
    "@sentry/node": "10.63.0",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "neverthrow": "8.2.0",
    "pino": "10.3.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "auth": "1.6.23",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
