  "workspaces": [
    "server",
    "web",
    "parser",
    "bookmarklet"
  ],
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
