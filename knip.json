{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@commitlint/cli"]
    },
    "server": {
      "entry": [
        "src/main.ts!",
        "src/auth-cli.ts",
        "src/db/migrate.{ts,mts,cts}!"
      ],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/**/test/**!",
        "!src/auth-cli.ts!",
        "!src/db/placeholder.ts!",
        "!src/resolve-test-database-url.ts!"
      ]
    }
  }
}
